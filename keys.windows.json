{
  "global": {
    "ctrl-shift-s": "mod.open:find"
  },
  "terminal": {
    "ctrl-shift-y": "mod.open:session_fork"
  },
  "mod:my-files": {
    "f2": "my-files.rename",
    "ctrl-n": "my-files.create-file",
    "ctrl-shift-n": "my-files.create-folder",
    "ctrl-shift-g": "my-files.goto"
  },
  "mod:file-tab": {
    "ctrl-s": "file-tab.save"
  },
  "layout:PA-Light": {
    "ctrl-shift-t": "prodsovet.new-terminal",
    "ctrl-t": "prodsovet.new-terminal",
    "ctrl-shift-o": "prodsovet.split-right",
    "ctrl-shift-e": "prodsovet.split-down"
  },
  "layout:PA-Advanced": {
    "ctrl-shift-t": "prodsovet.new-terminal",
    "ctrl-t": "prodsovet.new-terminal",
    "ctrl-shift-o": "prodsovet.split-right",
    "ctrl-shift-e": "prodsovet.split-down",
    "ctrl-shift-k": "prodsovet.picker",
    "ctrl-shift-n": "prodsovet.open-project",
    "ctrl-tab": "prodsovet.next-tab",
    "ctrl-shift-tab": "prodsovet.prev-tab",
    "ctrl-pagedown": "prodsovet.next-tab",
    "ctrl-pageup": "prodsovet.prev-tab"
  }
}
